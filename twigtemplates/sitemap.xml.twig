{% do header('Content-Type: application/xml; charset=utf-8') %}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url><loc>{{ _BASE }}</loc><priority>1.00</priority></url>
<url><loc>{{ _BASE }}download</loc><priority>0.90</priority></url>
{% for item in fetch("Post")|filter(item => item.Publish == 'true') %}
<url>
  <loc>{{ _BASE }}doc/{{ item.Slug }}</loc>
  <lastmod>{{ item.Date|date('Y-m-d') }}</lastmod>
  <priority>0.80</priority>
</url>
{% endfor %}
</urlset>
