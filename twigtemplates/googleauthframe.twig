<!DOCTYPE html>
<html lang="en">
<head>
  <base href="{{_BASE}}">
  <title>EvolvitCMS google auth</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="EvolvitCMS google auth"/>
  <meta name="keywords" content="Self hosted CMS EvolvitCMS Playground">

  <link rel="apple-touch-icon" sizes="180x180" href="favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="favicon/favicon-16x16.png">
  <link rel="manifest" href="favicon/site.webmanifest">
  <link rel="mask-icon" href="favicon/safari-pinned-tab.svg" color="#5bbad5">
  <meta name="msapplication-TileColor" content="#da532c">
  <meta name="theme-color" content="#ffffff">
  <meta name="google-signin-client_id" content="1059878098248-ug4kn2qe72tv2a3vfnjv739phs89615a.apps.googleusercontent.com">
  <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400&display=swap" rel="stylesheet">
</head>
<body style="margin:0; padding:0; overflow:hidden; font-family:'Fira Sans', sans-serif">
  <div id="signin-button" style="display:inline-block"></div>
  <a href="#" id="signout-link" style="display:none; color:#6c757d; line-height:40px; font-size:14px; text-decoration:none"
     onclick="EvolvitGoogle.signOut(); return false;">Sign out</a>

<script src="cms/googlesignin.js"></script>
<script>
  // Google sign-in frame embedded by the playground (<project>.evolvitcms.com/playground).
  // Only playground pages may talk to it: it can reveal the signed-in e-mail and project list.
  var PG_ORIGIN_RE = /^https:\/\/([a-z0-9-]+\.)?evolvitcms\.com$/
  var parentOrigin = null
  try { var ro = new URL(document.referrer).origin; if (PG_ORIGIN_RE.test(ro)) parentOrigin = ro } catch(e) {}
  function postMsg(msg){ if (parentOrigin && window.parent !== window) window.parent.postMessage(msg, parentOrigin) }

  var state = { isSignedIn: false, email: null }
  function setState(isSignedIn, email){
    state = { isSignedIn: isSignedIn, email: email }
    document.getElementById('signin-button').style.display = isSignedIn ? 'none' : 'inline-block'
    document.getElementById('signout-link').style.display = isSignedIn ? 'inline' : 'none'
    postMsg({ namespace: 'signin', data: state })
  }

  function post(url, data){
    var body = new FormData()
    Object.keys(data || {}).forEach(function(k){ body.append(k, data[k] === null ? '' : data[k]) })
    return fetch(url, { method: 'POST', credentials: 'same-origin', body: body }).then(function(r){ return r.json() })
  }

  // also refreshes the signed pg_owner cookie used by the playground
  function PlaygroundProjectsList(){ return post('auth/projects.php') }

  EvolvitGoogle.init({
    button: 'signin-button',
    signinUrl: 'auth/googletokensignin.php',
    buttonOptions: { theme: 'outline', size: 'large', text: 'signin', shape: 'rectangular', width: 170 },
    onSignIn: function(user){ setState(true, user.email) },
    onSignOut: function(){ setState(false, null) }
  })

  window.addEventListener('message', function(e){
    if (!PG_ORIGIN_RE.test(e.origin) || !e.data || !e.data.__seq) return
    parentOrigin = e.origin
    var reply = function(data){ e.source.postMessage({ data: data, __seq: e.data.__seq }, e.origin) }

    if (e.data.namespace == 'PlaygroundProjectsList') {
      PlaygroundProjectsList().then(reply)
      return
    }
    if (e.data.namespace == 'PlaygroundProjectsAdd') {
      post('cms/api.php?query=PlaygroundProjectsAdd', { Name: e.data.Name || '', Subdomain: e.data.Subdomain || '' })
        .then(function(data){ return PlaygroundProjectsList().then(function(){ reply((data && data.last_rowid) | 0) }) })
      return
    }
    if (e.data.namespace == 'isSignedIn') {
      reply(state)
      return
    }
    if (e.data.namespace == 'signIn' || e.data.namespace == 'gapi.auth2.getAuthInstance().signIn()') {
      if (!state.isSignedIn) EvolvitGoogle.prompt() // One Tap; the button in this frame works as well
      reply(state)
      return
    }
  }, false)
</script>
</body>
</html>
