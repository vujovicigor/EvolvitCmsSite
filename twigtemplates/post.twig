{% extends "base.twig" %}
{% set slug = _GET['1'] %}
{% set Post = fetch("Post", {id:slug})[0] %}
{% block description %}{{Post.Description}}{% endblock %}
{% block content %}
	<h5>{{Post.Title}} <tag style="float:right; text-transform: none;">Posted at {{Post.Date}}</tag></h5>
  {% if Post.Image %} <img src="img/{{Post.Image}}" style="object-fit: contain;width: auto;max-width: 100%;"> {% endif %}
  <div style="margin-top: 1rem;" >{{Post.Body | raw}} </div> 

  {% set Comment = fetch("Comment") %}
  <h2>Comment</h2>
  <table border=1 style="width:100%">
  <tr>
    <td>id</td>
    <td>PostId</td>
    <td>PostId</td>
    <td>Text</td>
    <td>Author</td>
    <td>ParentCommentId</td>
    <td>ParentCommentId</td>
  </tr>
  {% for item in Comment %}
  <tr>
    <td> {{item.id}} </td>
    <td> {{item.PostId}} </td>
    <td> {{item.PostId_label}} </td>
    <td> {{item.Text}} </td>
    <td> {{item.Author}} </td>
    <td> {{item.ParentCommentId}} </td>
    <td> {{item.ParentCommentId_label}} </td>
  </tr>
  {% endfor %}
  </table>



  <card>
    <h2>Post a Comment</h2>
    <textarea id="textComment" placeholder="Sign in to comment"></textarea>
    <div style="display:flex; justify-content: space-between;">
      <div id="my-signin2" style="display: inline-block;"></div>
      <button id="publishComment" disabled style="margin:0" onclick="postComment()">Publish</button>
    </div>
  </card>

  
  <script>

    // Google sign-in (Google Identity Services, see cms/googlesignin.js)
    var GoogleUserData = {}
    function onGoogleSignIn(user) {
      GoogleUserData = user
      document.getElementById("textComment").placeholder = "Enter your comment..."
      document.getElementById("publishComment").disabled = false
    }
    function onGoogleSignOut() {
      document.getElementById("textComment").placeholder = "Sign in to comment"
      document.getElementById("publishComment").disabled = true
    }
    document.addEventListener('DOMContentLoaded', function () {
      EvolvitGoogle.init({ button: 'my-signin2', onSignIn: onGoogleSignIn, onSignOut: onGoogleSignOut })
    })

  function postComment(){
    console.log('comm')
    var data = {};
    data.textComment = document.getElementById("textComment").value
    data.PostId = '{{Post.id}}'
    document.getElementById("textComment").value = '';

    var fd = new FormData();
    //very simply, doesn't handle complex objects
    for(var i in data){
      fd.append(i,data[i]);
    }

    var xhr = new XMLHttpRequest();
    xhr.open('POST', 'cms/postComment.php', true);
    //xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xhr.onload = function(resp) {
      console.log(resp)

    };
    xhr.send(fd);   


  }

  </script>

  <script src="cms/googlesignin.js"></script>


{% endblock %}
